[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
default_keyfile    = selfsigned.key
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
C  = US
ST = State
L  = City
O  = Organization
CN = frontend

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = frontend
DNS.2 = backend
DNS.3 = product
